# Samsun News frontend runtime environment
# Copy this file to frontend/.env.local for local Vite development.
# The Apps in Toss bundle reads Supabase directly with the anon key.
# Never put service-role keys or LLM provider keys in VITE_* variables.

VITE_SUPABASE_URL=https://srdvlalyucbokdwfkmcf.supabase.co
VITE_SUPABASE_ANON_KEY=<PASTE_SUPABASE_ANON_KEY_HERE>

# Apps in Toss / TDS provider
# 0 keeps local desktop browser development simple.
# Set to 1 when testing inside Toss WebView if TDS provider behavior is needed.
VITE_ENABLE_TDS_PROVIDER=0

# 1 prioritizes Korean-title, summary/translation-complete, fact-labeled rows first.
VITE_DEMO_POLISHED_FEED=1

# 1 hides source=DEMO, [시연용], is_demo=true, and is_hidden=true rows from final presentation feeds.
VITE_HIDE_DEMO_ARTICLES=1

# Apps in Toss Granite dev server host is a shell env, not a Vite env.
# Windows PowerShell example for real-device testing:
# $env:AIT_WEB_HOST="192.168.45.27"; npm run ait:dev
