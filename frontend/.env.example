# Samsun News frontend runtime environment
# Copy this file to frontend/.env.local for local Vite development.
# Do not put backend secrets or service role keys in VITE_* variables.

# Local browser development
VITE_API_BASE_URL=http://localhost:8000

# Apps in Toss / TDS provider
# 0 keeps local desktop browser development simple.
# Set to 1 when testing inside Toss WebView if TDS provider behavior is needed.
VITE_ENABLE_TDS_PROVIDER=0

# Optional direct Supabase read-only config. Current frontend uses the backend API,
# so these are placeholders for future RLS-backed direct reads only.
VITE_SUPABASE_URL=https://srdvlalyucbokdwfkmcf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<PASTE_SUPABASE_PUBLISHABLE_KEY_HERE>
