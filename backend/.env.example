# Samsun News FastAPI backend environment
# Copy to ../.env when running from the repository root, or export these vars
# in the process that starts uvicorn.

APP_ENV=local
LOG_LEVEL=info

# API / CORS
CORS_ORIGINS=http://localhost:5173,https://samsun-newsapp.apps.tossmini.com,https://samsun-newsapp.private-apps.tossmini.com
PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase
SUPABASE_URL=https://srdvlalyucbokdwfkmcf.supabase.co
SUPABASE_KEY=<PASTE_TEAM_ANON_KEY_HERE>
SUPABASE_ANON_KEY=<PASTE_TEAM_ANON_KEY_HERE>
# Backend/batch only. Never expose this in frontend/.env*.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_REVIEW_ENABLED=0

# LLM / search / fact check
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
MODE=cloud
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_FC_API_KEY=
MODEL_NAME=gemma4-e4b-samsun
OLLAMA_BASE_URL=http://localhost:11434

CUSTOM_MODEL_MODE=off
CUSTOM_MODEL_SERVER_URL=
CUSTOM_MODEL_TIMEOUT_SEC=60

FACTCHECK_ENABLED=1
CRAWLER_ENABLED=1
NEOLOGISM_RAG_ENABLED=1
