# Samsun News unified runtime environment
# Copy this file to .env at the repository root.

# Runtime
APP_ENV=local
LOG_LEVEL=info

# Backend API / CORS
# Apps in Toss production origin: https://<appName>.apps.tossmini.com
# Apps in Toss QR/private test origin: https://<appName>.private-apps.tossmini.com
CORS_ORIGINS=http://localhost:5173,https://samsun-newsapp.apps.tossmini.com,https://samsun-newsapp.private-apps.tossmini.com
PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend
# Vite reads this only from frontend/.env* files or CI env. Keep it here as the single source of truth.
# Local browser: http://localhost:8000
# Same-Wi-Fi mobile/Toss WebView test: http://<PC_INTERNAL_IP>:8000
# Apps in Toss upload/release: use an external HTTPS API URL.
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_TDS_PROVIDER=0

# Supabase
SUPABASE_URL=https://srdvlalyucbokdwfkmcf.supabase.co
SUPABASE_KEY=<PASTE_TEAM_ANON_KEY_HERE>
SUPABASE_ANON_KEY=<PASTE_TEAM_ANON_KEY_HERE>

# LLM / embedding
# Use openrouter/gemini in deployed environments. Use local only when Ollama is running on the same machine.
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
MODE=cloud
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_FC_API_KEY=
MODEL_NAME=gemma4-e2b-samsun-lora
OLLAMA_BASE_URL=http://localhost:11434

# Direct fine-tuned model integration
# off    : do not call a custom model
# batch  : custom model is used by offline/batch jobs before writing Supabase
# server : backend may call CUSTOM_MODEL_SERVER_URL at request/job time
CUSTOM_MODEL_MODE=off
CUSTOM_MODEL_SERVER_URL=
CUSTOM_MODEL_TIMEOUT_SEC=60

# Pipeline toggles
FACTCHECK_ENABLED=1
CRAWLER_ENABLED=1
NEOLOGISM_RAG_ENABLED=1
