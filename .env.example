# OpenRouter 번역·요약 LLM 호출용 API 키
OPENROUTER_API_KEY=
# OpenRouter API 베이스 URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter에서 사용할 모델 태그
OPENROUTER_MODEL=

# Ollama 로컬 서버 주소 (USE_LOCAL_LLM=true 일 때 사용)
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 번역·요약 모델 태그
OLLAMA_MODEL=
# Ollama 임베딩 전용 모델 태그 (1024차원)
OLLAMA_EMBED_MODEL=

# Supabase 프로젝트 URL
SUPABASE_URL=
# Supabase anon(public) 키 — 클라이언트에서 사용
SUPABASE_ANON_KEY=
# Supabase 공개 키 (SUPABASE_ANON_KEY와 동일하게 사용)
SUPABASE_KEY=
# Supabase service role 키 — 서버 전용, 절대 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=

# Railway 실행 환경 (development / production)
RAILWAY_ENVIRONMENT=development
# FastAPI 서버 포트
PORT=8000

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
# true면 Ollama 로컬 LLM, false면 OpenRouter 사용
USE_LOCAL_LLM=false
