# OpenRouter (Railway: 번역/요약/추천/임베딩; `.env`에 실제 키를 넣을 것)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-4b
# (선택) OpenRouter 임베딩 전용, 미설정 시 qwen/qwen3-embedding-4b
# OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# (선택) OpenRouter 권장 헤더
OPENROUTER_HTTP_REFERER=https://samsun-production.up.railway.app

# 로컬 Ollama 임베딩 (MODE=local) — URL만 지정, 없으면 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama 임베딩 모델명 (기본: qwen3-embedding:0.6b)
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# 임베딩/검색 모드: local(로컬 Ollama) | cloud( OpenRouter 임베딩 전용)
MODE=cloud

# Supabase, Gemini(신조어 RAG) 등 — 기존 백엔드와 동일
# SUPABASE_URL=
# SUPABASE_KEY=
# GEMINI_API_KEY=
