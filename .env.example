# Samsun News backend/batch runtime environment
# Copy this file to .env at the repository root for FastAPI and scripts.
# Frontend-only variables live in frontend/.env.example.

# Runtime
APP_ENV=local
LOG_LEVEL=info

# Backend API / CORS
# Apps in Toss production origin: https://<appName>.apps.tossmini.com
# Apps in Toss QR/private test origin: https://<appName>.private-apps.tossmini.com
CORS_ORIGINS=http://localhost:5173,https://samsun-newsapp.apps.tossmini.com,https://samsun-newsapp.private-apps.tossmini.com
PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase
SUPABASE_URL=https://srdvlalyucbokdwfkmcf.supabase.co
SUPABASE_KEY=<PASTE_TEAM_ANON_KEY_HERE>
SUPABASE_ANON_KEY=<PASTE_TEAM_ANON_KEY_HERE>
# Preferred for batch writes / Edge Function queue inserts. Never expose this to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function refresh trigger
# Store this as a Supabase function secret too:
#   supabase secrets set REFRESH_SECRET=<long-random-string>
REFRESH_SECRET=

# LLM / embedding
# Use openrouter/gemini in deployed environments. Use local only when Ollama is running on the same machine.
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
MODE=cloud
OPENROUTER_API_KEY=
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.5-flash
OPENROUTER_TITLE_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_FC_API_KEY=
MODEL_NAME=gemma4-e4b-samsun
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_CONFIGURED=0
LOCAL_LLM_ENDPOINT=

# Direct fine-tuned model integration
# off    : do not call a custom model
# batch  : custom model is used by offline/batch jobs before writing Supabase
# server : backend may call CUSTOM_MODEL_SERVER_URL at request/job time
CUSTOM_MODEL_MODE=off
CUSTOM_MODEL_SERVER_URL=
CUSTOM_MODEL_TIMEOUT_SEC=60

# Pipeline toggles
FACTCHECK_ENABLED=1
CRAWLER_ENABLED=1
NEOLOGISM_RAG_ENABLED=1
NEOLOGISM_PIPELINE_GEMINI=0
NEOLOGISM_SIM_THRESHOLD=0.85
